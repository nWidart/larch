---
// Replaces Starlight's hero: the copy on the left, the module graph on the right.
import { LinkButton } from '@astrojs/starlight/components';
import { groveSvg } from '../lib/grove.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero">
	<div class="copy">
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
	<figure class="graph">
		<Fragment set:html={groveSvg({ id: 'hero-grove' })} />
		<figcaption>Billing reaches Inventory through a facade. Larch draws that link, and fails it.</figcaption>
	</figure>
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
		padding-block: 2rem 1rem;
		align-items: center;
	}

	h1 {
		font-family: var(--larch-font-display);
		font-weight: 400;
		font-size: clamp(4rem, 3rem + 7vw, 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}

	.tagline {
		margin-top: 1.25rem;
		max-width: 34ch;
		font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		margin-top: 2rem;
	}

	.graph {
		margin: 0;
		max-width: 26rem;
		width: 100%;
		justify-self: center;
	}

	.graph :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
		text-wrap: balance;
	}

	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
			gap: 3rem;
			padding-block: clamp(3rem, 1rem + 8vmin, 7rem) 2rem;
		}
	}
</style>
